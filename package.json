{
  "name": "specsy",
  "version": "0.2.3",
  "description": "A linter for specifications. Catches vague, untestable, and untraceable requirements before an AI agent turns them into code.",
  "keywords": [
    "spec-driven-development",
    "sdd",
    "linter",
    "openspec",
    "spec-kit",
    "ai-agents",
    "requirements"
  ],
  "license": "MIT",
  "author": "Zaidnaz (https://github.com/Zaidnaz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaidnaz/specsy.git"
  },
  "homepage": "https://github.com/Zaidnaz/specsy#readme",
  "bugs": {
    "url": "https://github.com/Zaidnaz/specsy/issues"
  },
  "type": "module",
  "bin": {
    "specsy": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
